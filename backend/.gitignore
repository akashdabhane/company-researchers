# ==========================================
# Python Virtual Environments
# ==========================================
# Ignores your local virtual environment directory
.venv/
myvenv/
ENV/
env/

# ==========================================
# Byte-compiled / optimized / DLL files
# ==========================================
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# Flask and Project Environment Secrets
# ==========================================
# NEVER commit raw database files or environment secrets
instance/
.env
.flaskenv
*.db
*.sqlite

# ==========================================
# IDEs, Editors, and OS-specific files
# ==========================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.DS_Store
Thumbs.db

# ==========================================
# Testing, Coverage, and Distribution
# ==========================================
htmlcov/
.toml
.cache
.pytest_cache/
.coverage
.coverage.*
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg


